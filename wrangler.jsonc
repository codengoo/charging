{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tramsac",
  // Cùng tài khoản giữ zone cangao.asia với chiatien.
  "account_id": "905088b40a2385757fe35a28b31b68db",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  // Build dữ liệu chạy ở GitHub Action, không ở Worker (Free plan giới hạn 10ms CPU).
  // Frontend (Vite build) phục vụ như static assets; /data/* (R2), /station/* (preview link
  // chia sẻ, thay meta theo trạm; /tram/* cũ 301 sang), /en/* (bản tiếng Anh: meta + hreflang)
  // và /api/* chạy qua Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/data/*", "/station/*", "/tram", "/tram/*", "/api/*", "/en", "/en/*"]
  },
  // Giới hạn /api/{route,geocode,revgeocode,maps-link} theo IP — chặn người ngoài dùng ké quota
  // HERE. period chỉ nhận 10 hoặc 60. Key HERE: `npx wrangler secret put HERE_API_KEY`.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    // Ghi đánh giá / bình luận / báo cáo (worker/reviews.ts): 5 lần mỗi phút mỗi IP.
    { "name": "REVIEW_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // D1 đánh giá + bình luận (tạo 2026-11-17, region APAC). Migration:
  // `npx wrangler d1 migrations apply tramsac-reviews --remote`. Local: `--local`.
  "d1_databases": [
    { "binding": "REVIEWS", "database_name": "tramsac-reviews", "database_id": "8b1afd41-c8b0-45e3-83b8-97c52cc854cc", "migrations_dir": "migrations" }
  ],
  // R2 chứa base/power/manifest do builder sinh ra.
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "tramsac-data" }],
  // Domain riêng (zone cangao.asia nằm trong tài khoản này).
  "routes": [{ "pattern": "charging.cangao.asia", "custom_domain": true }],
  // Workers Logs: worker/locator.ts ghi một dòng JSON mỗi request /api/station để đo VinFast
  // chặn ra sao trên lưu lượng thật.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,
  "preview_urls": false
}
