{
  "name": "Bản đồ trạm sạc ô tô VinFast",
  "short_name": "Trạm Sạc",
  "description": "Bản đồ ~25.000 trạm sạc ô tô VinFast — trạm gần bạn, trạm dọc đường, lọc, lưu yêu thích, chỉ đường.",
  "lang": "vi",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#009966",
  "share_target": {
    "action": "/trip",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    {
      "name": "Trạm gần tôi",
      "short_name": "Gần tôi",
      "description": "Trạm sạc đang hoạt động gần vị trí hiện tại",
      "url": "/?open=nearby",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Trạm dọc đường",
      "short_name": "Dọc đường",
      "description": "Tìm trạm sạc dọc tuyến đường Google Maps",
      "url": "/trip",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quét QR trạm",
      "short_name": "Quét QR",
      "description": "Quét mã QR trên thẻ trạm để mở trạm",
      "url": "/?open=scan",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
